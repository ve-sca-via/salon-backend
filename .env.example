# =====================================================
# ENVIRONMENT CONFIGURATION
# IMPORTANT: All keys below are REQUIRED. No defaults are provided.
# Copy this file to .env and fill in all values explicitly.
# =====================================================

# Application Settings
APP_NAME=""
APP_VERSION=""
APP_DESCRIPTION=""
ENVIRONMENT=""  # development, staging, production
DEBUG=""  # true or false
API_PREFIX=""

# Server Configuration
HOST=""
PORT=""
WORKERS=""
TOKEN_CLEANUP_INTERVAL_SECONDS=""  # seconds
BACKGROUND_SHUTDOWN_TIMEOUT_SECONDS=""  # seconds (float)

# CORS Settings
# ALLOWED_ORIGINS: full URLs WITH scheme, NO trailing slash, comma-separated.
#   Examples (do): https://app.example.com,https://admin.example.com
#   Wrong (don't): app.example.com           -> missing scheme
#   Wrong (don't): https://app.example.com/  -> trailing slash
# In development, localhost origins (:3000, :5173, :8080) are auto-included.
# In production this MUST NOT be empty (app refuses to start).
ALLOWED_ORIGINS=""

# ALLOWED_HOSTS: hostnames ONLY, NO scheme, NO path, comma-separated.
#   Examples (do): api.example.com,api-staging.example.com
#   Also fine:     api.example.com:8080      -> port allowed
#   Also fine:     *.railway.app             -> wildcard subdomain
#   Wrong (don't): https://api.example.com   -> scheme is stripped with a warning
# Only enforced in production. In development this can be left blank.
ALLOWED_HOSTS=""
# =====================================================
# SUPABASE CONFIGURATION
# =====================================================
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Database (Supabase PostgreSQL)
DATABASE_URL=""

# =====================================================
# JWT & AUTHENTICATION
# =====================================================
JWT_SECRET_KEY=""  # Must be at least 32 characters
JWT_ALGORITHM=""
ACCESS_TOKEN_EXPIRE_MINUTES=""
REFRESH_TOKEN_EXPIRE_DAYS=""

# =====================================================
# PAYMENT GATEWAY (RAZORPAY)
# =====================================================
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# =====================================================
# EMAIL CONFIGURATION
# =====================================================
# Must be an address on a domain verified in Resend, or every send is
# rejected with HTTP 422.
EMAIL_FROM=""            # e.g. noreply@lubist.in
EMAIL_FROM_NAME=""       # e.g. Lubist
ADMIN_EMAIL=""           # inbox for admin notifications (career, vendor requests, partner leads)

# Resend API key (https://resend.com/api-keys). Leave blank to disable sending:
# the app still boots and logs a warning instead of delivering.
RESEND_API_KEY=""

# =====================================================
# FRONTEND URLS
# =====================================================
FRONTEND_URL=""
ADMIN_PANEL_URL=""
VENDOR_PORTAL_URL=""
RM_PORTAL_URL=""

# =====================================================
# LOGGING
# =====================================================
LOG_LEVEL=""  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=""

# =====================================================
# OTP SERVICE (MESSAGECENTRAL)
# =====================================================
# Both values come from the MessageCentral dashboard ("Your Credentials").
MESSAGECENTRAL_CUSTOMER_ID=""
# PREFERRED: paste the dashboard "Auth Token" (a long-lived eyJ... JWT) here.
# When set, the app uses it directly and skips the legacy token-generation call.
MESSAGECENTRAL_AUTH_TOKEN=""
# LEGACY (leave blank if you set MESSAGECENTRAL_AUTH_TOKEN above): the old flow
# generates a token from the Base64-encoded account PASSWORD + email. A wrong/stale
# key makes MessageCentral return {"status":400,"error":"password is wrong"} -> 503.
MESSAGECENTRAL_KEY=""
MESSAGECENTRAL_EMAIL=""
MESSAGECENTRAL_BASE_URL=""
MESSAGECENTRAL_DEFAULT_COUNTRY_CODE=""
MESSAGECENTRAL_OTP_LENGTH=""
MESSAGECENTRAL_OTP_EXPIRY_SECONDS=""

# Dev only: when "true" (and ENVIRONMENT is not production), OTPs are generated
# and printed to the server log instead of being sent via SMS. Default: false.
OTP_DEV_MODE="false"

# =====================================================
# CLOUDINARY SETTINGS
# =====================================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CAREER_CLOUDINARY_UPLOAD_TYPE=""  # private or public
CAREER_CLOUDINARY_SIGNED_URL_TTL=""  # seconds
