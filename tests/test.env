# =====================================================
# TEST / CI ENVIRONMENT — DUMMY VALUES ONLY
# =====================================================
# Loaded by tests/conftest.py before the app is imported, so Settings()
# validates successfully in CI without real secrets.
#
# These values are intentionally fake. The Supabase URL/keys point at the
# LOCAL Supabase stack (`supabase start`), whose demo keys are public and
# only work against a local instance. NEVER put real secrets in this file.
# =====================================================

# Application Settings
APP_NAME="Salon Management API (test)"
APP_VERSION="0.0.0-test"
APP_DESCRIPTION="Test environment"
ENVIRONMENT="development"
DEBUG="true"
API_PREFIX="/api"

# Server Configuration
HOST="127.0.0.1"
PORT="8000"
WORKERS="1"
TOKEN_CLEANUP_INTERVAL_SECONDS="3600"
BACKGROUND_SHUTDOWN_TIMEOUT_SECONDS="5.0"

# CORS / Hosts (development auto-includes localhost, so these can be minimal)
ALLOWED_ORIGINS="http://localhost:3000"
ALLOWED_HOSTS=""

# =====================================================
# SUPABASE — LOCAL STACK (`supabase start`)
# Demo keys below are public, local-only. Do not use against any real project.
# =====================================================
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE2NDE3NjkyMDAsImV4cCI6MTc5OTUzNTYwMH0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q"

# Database (local Supabase Postgres)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# =====================================================
# JWT & AUTHENTICATION
# =====================================================
JWT_SECRET_KEY="test-jwt-secret-key-not-for-production-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# =====================================================
# PAYMENT GATEWAY (RAZORPAY) — dummy
# =====================================================
RAZORPAY_KEY_ID="rzp_test_dummy"
RAZORPAY_KEY_SECRET="dummy_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="dummy_razorpay_webhook_secret"

# =====================================================
# EMAIL CONFIGURATION — dummy
# =====================================================
EMAIL_FROM="noreply@test.local"
EMAIL_FROM_NAME="Salon Test"
ADMIN_EMAIL="admin@test.local"

# Deliberately blank: with no API key the Resend transport short-circuits as a
# permanent failure, so tests never touch the network and never burn the retry
# backoff (~7s each). Tests that assert on send behaviour stub the transport.
RESEND_API_KEY=""

# =====================================================
# FRONTEND URLS — dummy
# =====================================================
FRONTEND_URL="http://localhost:3000"
ADMIN_PANEL_URL="http://localhost:3001"
VENDOR_PORTAL_URL="http://localhost:3002"
RM_PORTAL_URL="http://localhost:3003"

# =====================================================
# LOGGING
# =====================================================
LOG_LEVEL="WARNING"
LOG_FILE="logs/test.log"

# =====================================================
# OTP SERVICE (MESSAGECENTRAL) — dummy, dev mode on so no SMS is sent
# =====================================================
MESSAGECENTRAL_CUSTOMER_ID="dummy_customer_id"
MESSAGECENTRAL_KEY="dummy_key"
MESSAGECENTRAL_EMAIL="otp@test.local"
MESSAGECENTRAL_BASE_URL="https://cpaas.messagecentral.com"
MESSAGECENTRAL_DEFAULT_COUNTRY_CODE="91"
MESSAGECENTRAL_OTP_LENGTH="6"
MESSAGECENTRAL_OTP_EXPIRY_SECONDS="300"
OTP_DEV_MODE="true"

# =====================================================
# CLOUDINARY SETTINGS — dummy
# =====================================================
CLOUDINARY_CLOUD_NAME="dummy_cloud"
CLOUDINARY_API_KEY="dummy_api_key"
CLOUDINARY_API_SECRET="dummy_api_secret"
CAREER_CLOUDINARY_UPLOAD_TYPE="private"
CAREER_CLOUDINARY_SIGNED_URL_TTL="3600"
