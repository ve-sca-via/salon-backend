# =====================================================
# STAGING ENVIRONMENT CONFIGURATION
# Copy this file to .env.staging and fill in staging values.
# This file is intended for hosted staging services, including Resend.
# =====================================================

# Application Settings
APP_NAME=""
APP_VERSION=""
APP_DESCRIPTION=""
ENVIRONMENT="staging"
DEBUG="true"
API_PREFIX="/api/v1"

# Server Configuration
HOST="0.0.0.0"
PORT="8000"
WORKERS="1"
TOKEN_CLEANUP_INTERVAL_SECONDS="300"
BACKGROUND_SHUTDOWN_TIMEOUT_SECONDS="10"

# CORS / Hosts
ALLOWED_ORIGINS=""
ALLOWED_HOSTS=""

# Supabase / Database
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL=""

# JWT & Auth
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email
EMAIL_PROVIDER="resend"
EMAIL_FROM=""
EMAIL_FROM_NAME=""
ADMIN_EMAIL=""
RESEND_API_KEY=""

# SMTP settings are optional for staging when EMAIL_PROVIDER=resend.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_TLS="true"
SMTP_SSL="false"

# Frontend URLs
FRONTEND_URL=""
ADMIN_PANEL_URL=""
VENDOR_PORTAL_URL=""
RM_PORTAL_URL=""

# Logging
LOG_LEVEL="INFO"
LOG_FILE=""

# OTP Service (MessageCentral)
MESSAGECENTRAL_CUSTOMER_ID=""
MESSAGECENTRAL_KEY=""
MESSAGECENTRAL_EMAIL=""
MESSAGECENTRAL_BASE_URL=""
MESSAGECENTRAL_DEFAULT_COUNTRY_CODE="91"
MESSAGECENTRAL_OTP_LENGTH="6"
MESSAGECENTRAL_OTP_EXPIRY_SECONDS="300"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CAREER_CLOUDINARY_UPLOAD_TYPE="private"
CAREER_CLOUDINARY_SIGNED_URL_TTL="900"
